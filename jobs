def now():
    return datetime.datetime.now().isoformat(timespec="seconds")


def dossier_id(arg):
    """Accept a slug, company/role, or a path to the dossier file."""
    return arg.removeprefix("content/").removeprefix("companies/").removesuffix(".md").removesuffix("/_index")


def dossier_path(ident):
    """The dossier file for a company slug or company/role id, or None."""
    if not re.fullmatch(r"[a-z0-9-]+(/[a-z0-9-]+)?", ident):
        return None
    if ident.startswith("people/"):
        path = CONTENT / f"{ident}.md"
        return path if path.exists() else None
    path = COMPANIES / (f"{ident}.md" if "/" in ident else f"{ident}/_index.md")
    return path if path.exists() else None


def state_problems(extra):
    """Messages for pipeline fields and notes that break the rules in STATE."""
    problems = []
    for key, kind in STATE.items():
        if key not in extra:
            continue
        v = extra[key]
        if kind == "time" and not (isinstance(v, str) and TIME.fullmatch(v)):
            problems.append(f"{key} = {v!r} is not YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS")
        elif kind == "flag" and v is not True:
            problems.append(f"{key} must be true or absent")
        elif isinstance(kind, list) and v not in kind:
            problems.append(f"{key} must be one of: {' '.join(kind)}")
    for choice, stamp in STAMPS.items():
        if (choice in extra) != (stamp in extra):
            problems.append(f"{choice} and {stamp} are set together")
    if "review" in extra and "profiled" not in extra:
        problems.append("review needs profiled first")
    for note in extra.get("notes", []):
        if not (isinstance(note, dict) and set(note) == {"time", "text"}
                and TIME.fullmatch(str(note["time"])) and str(note["text"]).strip()):
            problems.append(f"note {note!r} needs exactly a time and a text")
    return problems


def without(text, keys):
    """A dossier's frontmatter and body with these [extra] fields removed, for comparing versions."""
    m = FRONTMATTER.match(text)
    try:
        fm = tomllib.loads(m.group(1))
    except (AttributeError, tomllib.TOMLDecodeError):
        return text
    for key in keys:
        fm.get("extra", {}).pop(key, None)
    return fm, text[m.end():]


def without_state(text):
    """Everything but the user's labels, notes, and flags: what commit_state compares."""
    return without(text, [*STATE, "notes"])


def write_state(path, changes, notes=()):
    """Set fields (a None value removes one) and append (time, text) notes in a dossier's frontmatter.

    Handles the pipeline fields in STATE and the captured fields in CAPTURE, which sit in that
    order at the end of the [extra] table. Other frontmatter lines and the body stay byte for
    byte. Refuses to write a result that breaks the rules in STATE or parses differently from
    what was asked."""
    with state_lock:
        text = path.read_text()
        m = FRONTMATTER.match(text)
        if not m:
            die(f"{path.relative_to(ROOT)}: missing +++ frontmatter")
        extra = tomllib.loads(m.group(1)).get("extra", {})
        managed = [*CAPTURE, *STATE]
        state = {k: extra[k] for k in managed if k in extra}
        for k, v in changes.items():
            if v is None:
                state.pop(k, None)
            else:
                state[k] = v

        lines = m.group(1).split("\n")
        if "[extra]" not in lines:
            lines.append("[extra]")
        start = lines.index("[extra]") + 1
        end = next((i for i in range(start, len(lines)) if lines[i].startswith("[")), len(lines))
        table = [line for line in lines[start:end] if not MANAGED_LINE.match(line)]
        while table and not table[-1].strip():
            table.pop()
        table += [f"{k} = {cell_toml(state[k])}" for k in managed if k in state]
        tail = lines[end:]
        for time, note in notes:
            tail += ["", "[[extra.notes]]", f"time = {toml_str(time)}", f"text = {toml_str(note.strip())}"]
        fm = "\n".join(lines[:start] + table + ([""] if end < len(lines) else []) + tail)
        new = f"+++\n{fm}{text[m.end(1):]}"

        new_extra = tomllib.loads(fm).get("extra", {})
        problems = state_problems(new_extra)
        if without(text, [*managed, "notes"]) != without(new, [*managed, "notes"]) \
                or {k: new_extra[k] for k in managed if k in new_extra} != state \
                or new_extra.get("notes", []) != extra.get("notes", []) + [{"time": t, "text": n.strip()} for t, n in notes]:
            problems.append("the rewritten frontmatter doesn't match the change; nothing written")
        if problems:
            die(f"{path.relative_to(ROOT)}: " + "; ".join(problems))
        tmp = path.with_name(path.name + ".tmp")
        tmp.write_text(new)
        os.replace(tmp, path)


AUTHORED = {"screen": ["PASS", "HOLD", "FAIL"], "confidence": ["low", "medium", "high"],
            "location": "text", "tier": [1, 2, 3], "category": "text"}
VERDICT_LEAD = re.compile(r"^(PASS|HOLD|FAIL)\b", re.I)
CARD_WORDS = 110  # tier 1: the description plus at most 80 words, and a case against


def set_fields(path, fields):
    """Set authored [extra] scalars, leaving the managed fields and the body untouched."""
    text = path.read_text()
    m = FRONTMATTER.match(text)
    if not m:
        die(f"{path.relative_to(ROOT)}: missing +++ frontmatter")
    lines = m.group(1).split("\n")
    start = lines.index("[extra]") + 1 if "[extra]" in lines else len(lines)
    end = next((i for i in range(start, len(lines)) if lines[i].startswith("[")), len(lines))
    at = next((i for i in range(start, end) if MANAGED_LINE.match(lines[i])), end)
    for key, value in fields.items():
        line = f"{key} = {cell_toml(value)}"
        here = next((i for i in range(start, end) if re.match(rf"{key}\s*=", lines[i])), None)
        if here is None:
            lines.insert(at, line)
            at += 1
            end += 1
        else:
            lines[here] = line
    new = f"+++\n{'\n'.join(lines)}{text[m.end(1):]}"
    extra = tomllib.loads("\n".join(lines)).get("extra", {})
    for key, value in fields.items():
        kind = AUTHORED.get(key)
        if isinstance(kind, list) and value not in kind:
            die(f"{key} must be one of: {' '.join(str(k) for k in kind)}")
        if extra.get(key) != value:
            die(f"{path.relative_to(ROOT)}: {key} did not round-trip; nothing written")
    if without(text, [*CAPTURE, *STATE, "notes", *fields]) != without(new, [*CAPTURE, *STATE, "notes", *fields]):
        die(f"{path.relative_to(ROOT)}: the rewrite changed more than {', '.join(fields)}")
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(new)
    os.replace(tmp, path)


def write_card(path, card):
    """Replace the first paragraph and the case against, keeping any later sections."""
    fm, body = read_doc(path)
    card = card.strip() + "\n"
    first = card.split("\n\n")[0].strip()
    if VERDICT_LEAD.match(first):
        die("the first paragraph describes the company; the screen field carries PASS, HOLD or FAIL")
    if "## Case against" not in card:
        die("the card needs a '## Case against' section")
    if len(card.split()) > CARD_WORDS:
        die(f"{len(card.split())} words; a tier 1 card is at most {CARD_WORDS}")
    keep = ""
    for m in re.finditer(r"^## (.+)$", body, re.M):
        if m.group(1).strip().lower() != "case against":
            keep = body[m.start():]
            break
    text = path.read_text()
    head = text[:FRONTMATTER.match(text).end()]
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(head + card + ("\n" + keep if keep else ""))
    os.replace(tmp, path)


def capture_index():
    """Map a captured URL to its newest capture directory."""
    index = {}
    for run in sorted(CAPTURES.glob("*"), key=lambda d: d.name):
        for d in run.iterdir():
            meta = d / "meta.json"
            if meta.exists():
                try:
                    index[normalize_url(json.loads(meta.read_text())["requested"])] = d
                except (json.JSONDecodeError, KeyError):
                    pass
    return index


def cmd_evidence(args):
    """Print what the phone saw for each company: the site's own words, links, and page text."""
    ids = [dossier_id(i) for i in args.ids]
    if not ids:
        ids = [slug for slug, d in companies()
               if (lambda e: e.get("captured") and not e.get("screen"))(read_doc(d / "_index.md")[0].get("extra", {}))]
    index = capture_index()
    for ident in ids:
        path = COMPANIES / ident / "_index.md"
        if not path.exists():
            print(f"# {ident}: no dossier", flush=True)
            continue
        fm, body = read_doc(path)
        extra = fm.get("extra", {})
        d = index.get(normalize_url(extra.get("website", ""))) if extra.get("website") else None
        print(f"### {ident}")
        print(f"name: {fm['title']}")
        print(f"website: {extra.get('website', '-')}")
        print(f"category: {extra.get('category', '-')}")
        print(f"captured: {extra.get('captured', 'not captured')}")
        for key in ("site_final", "site_error", "site_title", "site_description"):
            if extra.get(key):
                print(f"{key}: {extra[key]}")
        if extra.get("profiles"):
            print("profiles: " + " ".join(extra["profiles"]))
        print(f"card now: {body.strip().split(chr(10) + chr(10))[0]}")
        if d and (d / "text.txt").exists():
            text = re.sub(r"\n{2,}", "\n", (d / "text.txt").read_text(errors="replace")).strip()
            print(f"--- page text ({d.name}) ---")
            print(text[:args.chars])
        print("### end\n", flush=True)


def cmd_reprocess(args):
    """Re-read the site's words from captures already on disk. No phone needed."""
    index = capture_index()
    print("\t".join(["id", "profiles", "changed"]))
    for slug, d in companies():
        path = d / "_index.md"
        extra = read_doc(path)[0].get("extra", {})
        cap = index.get(normalize_url(extra.get("website", ""))) if extra.get("website") else None
        if not cap or not (cap / "page.html").exists():
            continue
        meta = json.loads((cap / "meta.json").read_text())
        title, desc, profiles = site_facts((cap / "page.html").read_text(errors="replace"))
        same = company_token(meta["url"]) == company_token(meta["requested"])
        changes = {"captured": extra.get("captured") or today(), "site_title": title or None,
                   "site_description": desc or None, "site_final": None if same else meta["url"],
                   "profiles": profiles or None, "site_error": None}
        was = {k: extra.get(k) for k in changes}
        if was == changes:
            continue
        write_state(path, changes)
        print("\t".join([slug, str(len(profiles)),
                          ",".join(k for k in changes if was.get(k) != changes[k])]), flush=True)


def cmd_card(args):
    """Screen a company and rewrite its card from the evidence."""
    path = dossier_path(dossier_id(args.id))
    if not path or path.name != "_index.md":
        die(f"'{args.id}' is not a company")
    fields = {"screen": args.screen}
    if args.confidence:
        fields["confidence"] = args.confidence
    if args.location:
        fields["location"] = args.location
    card = sys.stdin.read()
    if not card.strip():
        die("pipe the card body (first paragraph, then ## Case against) on stdin")
    write_card(path, card)
    set_fields(path, fields)
    print(dossier_id(args.id))


def add_note(ident, note, time=None):
    write_state(dossier_path(ident), {}, [(time or now(), note)])


def current_flags():
    """Map id to the set of flags currently on."""
    flags = {}
    for ident, _, fm in triage_items():
        on = {f for f in FLAGS if fm.get("extra", {}).get(f)}
        if on:
            flags[ident] = on
    return flags


def triage_labels():
    """Current triage label per dossier id."""
    return {ident: fm["extra"]["triage"] for ident, _, fm in triage_items() if fm.get("extra", {}).get("triage")}


def pipeline_state(extra):
    """(state, since): the outcome once closed, otherwise the furthest stage reached."""
    if extra.get("outcome"):
        return extra["outcome"], extra.get("closed", "")
    reached = [s for s in STAGES if s in extra]
    return (reached[-1], extra[reached[-1]]) if reached else ("", "")


def find_app(query):
    matches = [a for a in applications() if query in a[0]]
    exact = [a for a in matches if a[0] == query]
    if exact:
        return exact[0]
    if not matches:
        die(f"no application matches '{query}'")
    if len(matches) > 1:
        die(f"'{query}' matches several applications:\n  "
            + "\n  ".join(a[0] for a in matches))
    return matches[0]


def company_index():
    """Map compacted slug, title, and website host tokens to company slugs."""
    index = {}
    for slug, d in companies():
        fm = read_doc(d / "_index.md")[0]
        keys = {compact(slug), compact(fm["title"])}
        for field in ("website", "careers"):
            if fm.get("extra", {}).get(field):
                keys.add(company_token(fm["extra"][field]))
        for k in fm.get("extra", {}).get("aliases", []):
            keys.add(compact(k))
        for k in keys:
            index.setdefault(k, slug)
    return index


def known_urls():
    """Map normalized posting URL to (kind, id) for every role and application."""
    urls = {}
    for role_id, _, fm in roles():
        if fm.get("extra", {}).get("url"):
            urls[normalize_url(fm["extra"]["url"])] = ("role", role_id)
    for app_id, _, fm in applications():
        if fm.get("extra", {}).get("url"):
            urls[normalize_url(fm["extra"]["url"])] = ("applied", app_id)
    return urls


