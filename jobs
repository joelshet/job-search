def cmd_set(args):
    ident = dossier_id(args.id)
    path = dossier_path(ident) or die(f"no company or role dossier '{ident}'")
    changes = {}
    for arg in args.fields:
        key, eq, value = arg.partition("=")
        kind = STATE.get(key)
        if kind is None:
            die(f"unknown field '{key}'; fields are: {' '.join(STATE)}")
        if eq and not value:
            changes[key] = None
            if key in STAMPS:
                changes[STAMPS[key]] = None
        elif kind == "time":
            changes[key] = value or now()
        elif kind == "flag":
            if value:
                die(f"'{key}' sets {key} and '{key}=' clears it; it takes no value")
            changes[key] = True
        elif value in kind:
            changes[key] = value
            changes.setdefault(STAMPS[key], now())
        else:
            die(f"{key} must be one of: {' '.join(kind)}")
    write_state(path, changes)
    extra = read_doc(path)[0].get("extra", {})
    for key in changes:
        print(f"{ident}\t{key}\t{cell(extra.get(key))}")


