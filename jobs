def die(msg):
    print(f"jobs: {msg}", file=sys.stderr)
    sys.exit(1)


def today():
    return datetime.date.today().isoformat()


def slugify(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def compact(text):
    return re.sub(r"[^a-z0-9]", "", text.lower())


def normalize_url(url):
    """Canonical form for duplicate detection: no tracking params, fragment, or apply suffix."""
    u = urllib.parse.urlsplit(url.strip())
    host = u.netloc.lower().removeprefix("www.")
    path = re.sub(r"/(apply|application)/?$", "", u.path).rstrip("/")
    query = urllib.parse.urlencode(sorted(
        (k, v) for k, v in urllib.parse.parse_qsl(u.query) if not TRACKING.match(k)))
    return urllib.parse.urlunsplit(("https", host, path, query, ""))


def company_token(url):
    """Best guess at the company name inside a URL."""
    u = urllib.parse.urlsplit(url)
    host = u.netloc.lower().removeprefix("www.")
    segments = [s for s in u.path.split("/") if s]
    if host in ATS_PATH and segments:
        return compact(segments[0])
    for suffix in ATS_SUBDOMAIN:
        if host.endswith("." + suffix):
            return compact(host.removesuffix("." + suffix).split(".")[-1])
    parts = host.split(".")
    return compact(parts[-2] if len(parts) >= 2 else host)


def looks_like_posting(url):
    u = urllib.parse.urlsplit(url)
    host = u.netloc.lower().removeprefix("www.")
    segments = [s for s in u.path.split("/") if s]
    if host in ATS_PATH:
        return len(segments) >= 2
    if re.match(r"(careers|jobs)\.", host) and segments:
        return True
    return bool(re.search(r"/(jobs?|careers?|positions?|openings?|roles?)/[^/]+", u.path)) \
        or "gh_jid" in u.query or "jobId" in u.query


class SitePage(HTMLParser):
    """Enough of a captured page to describe it: its title, meta tags, and links."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.meta, self.links, self.title, self._in_title = {}, [], "", False

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag == "meta":
            key = (a.get("name") or a.get("property") or "").lower()
            if key and a.get("content", "").strip():
                self.meta.setdefault(key, a["content"].strip())
        elif tag == "a" and a.get("href"):
            self.links.append(a["href"])
        elif tag == "title" and not self.title:
            self._in_title = True

    def handle_data(self, data):
        if self._in_title:
            self.title += data

    def handle_endtag(self, tag):
        if tag == "title":
            self._in_title = False


def profile(url):
    """(host, canonical url) when this link is a company profile, else None."""
    u = urllib.parse.urlsplit(url)
    host = u.netloc.lower().removeprefix("www.").removeprefix("m.")
    host = PROFILE_ALIAS.get(host, host)
    depth = next((d for h, d in PROFILE_HOSTS if host == h or host.endswith("." + h)), None)
    if depth is None:
        return None
    segments = [s for s in u.path.split("/") if s]
    if not segments or segments[0].lower() in NOT_PROFILE:
        return None
    if host == "youtube.com":
        if segments[0].lower() in ("c", "channel", "user"):
            depth = 2
        elif not segments[0].startswith("@"):
            return None  # a bare youtube.com path is a video, not the company's channel
    if host == "linkedin.com" and segments[0].lower() not in ("company", "school"):
        return None  # a founder's own profile isn't the company's presence
    return host, f"https://{host}/" + "/".join(segments[:depth])


def site_facts(page_html):
    """(title, description, profile urls) as the site itself states them."""
    p = SitePage()
    p.feed(page_html)
    title = re.sub(r"\s+", " ", html.unescape(p.title)).strip()
    desc = p.meta.get("description") or p.meta.get("og:description") or ""
    desc = re.sub(r"\s+", " ", html.unescape(desc)).strip()
    best = {}
    for link in p.links:
        found = profile(link)
        if found:
            host, url = found
            if host not in best or len(url) < len(best[host]):
                best[host] = url
    order = [h for h, _ in PROFILE_HOSTS]
    return title, desc, [best[h] for h in order if h in best]


def parse_value(v):
    if v.startswith("["):
        return json.loads(v)
    for cast in (int, float):
        try:
            return cast(v)
        except ValueError:
            pass
    return v


def frontmatter(title, extra):
    lines = ["+++", f"title = {toml_str(title)}", "[extra]"]
    lines += [f"{k} = {toml_str(v)}" for k, v in extra.items() if v not in (None, "")]
    return "\n".join(lines + ["+++", ""])


def read_body_from_stdin():
    if sys.stdin.isatty():
        die("pipe the dossier body (BLUF paragraph first) on stdin")
    body = sys.stdin.read().strip()
    if not body:
        die("dossier body on stdin is empty")
    return body + "\n"


FRONTMATTER = re.compile(r"\+\+\+\n(.*?)\n\+\+\+\n?", re.S)


def read_doc(path):
    """Return (frontmatter dict, body) for a +++ TOML-fronted markdown file."""
    text = path.read_text()
    m = FRONTMATTER.match(text)
    if not m:
        die(f"{path.relative_to(ROOT)}: missing +++ frontmatter")
    try:
        return tomllib.loads(m.group(1)), text[m.end():]
    except tomllib.TOMLDecodeError as e:
        die(f"{path.relative_to(ROOT)}: {e}")


def cell_toml(v):
    if v is True:
        return "true"
    if isinstance(v, list):
        return "[" + ", ".join(toml_str(str(i)) for i in v) + "]"
    return toml_str(v)


def toml_str(s):
    return json.dumps(s, ensure_ascii=False)


def cell(v):
    """A frontmatter value as a TSV cell."""
    return "-" if v is None else "true" if v is True else str(v)


