def roles():
    """Yield (role_id, path, frontmatter) for every role dossier."""
    for slug, d in companies():
        for p in sorted(d.glob("*.md")):
            if p.name != "_index.md":
                yield f"{slug}/{p.stem}", p, read_doc(p)[0]


def dossiers(kind="all"):
    """Yield (id, path, frontmatter) for every company, then every role."""
    if kind in ("all", "company"):
        for slug, d in companies():
            yield slug, d / "_index.md", read_doc(d / "_index.md")[0]
    if kind in ("all", "role"):
        yield from roles()


