def cmd_match(args):
    text = sys.stdin.read() if not args.files else ""
    pairs = [(u, Path("-")) for u in re.findall(r"https?://[^\s<>\"')\]]+", text)]
    for name in args.files:
        pairs += [(u, Path(name)) for u in re.findall(r"https?://[^\s<>\"')\]]+", Path(name).read_text())]
    match_urls(pairs)


def match_urls(pairs):
    """TSV: status, id, posting|page, normalized url, source. Status is applied, role, company, or new."""
    urls, index, seen = known_urls(), company_index(), set()
    for raw, source in pairs:
        url = normalize_url(raw)
        if url in seen:
            continue
        seen.add(url)
        kind = "posting" if looks_like_posting(url) else "page"
        if url in urls:
            status, ident = urls[url]
        elif company_token(url) in index:
            status, ident = "company", index[company_token(url)]
        else:
            status, ident = "new", "-"
        src = source if str(source) == "-" else source.relative_to(ROOT) if source.is_absolute() else source
        print(f"{status}\t{ident}\t{kind}\t{url}\t{src}")


def parse_sets(pairs):
    extra = {}
    for pair in pairs:
        if "=" not in pair:
            die(f"--set expects key=value, got '{pair}'")
        k, v = pair.split("=", 1)
        extra[k] = parse_value(v)
    return extra


def new_company(name, extra, body=""):
    """Write a company dossier and return its slug; refuse a name or website already on file."""
    slug = slugify(name)
    index = company_index()
    clash = index.get(compact(name)) or (
        extra.get("website") and index.get(company_token(extra["website"])))
    if clash or (COMPANIES / slug).exists():
        die(f"company already exists: {clash or slug}")
    extra.setdefault("tier", 1)
    extra.setdefault("score", 0)
    extra.setdefault("found", today())
    (COMPANIES / slug).mkdir(parents=True)
    (COMPANIES / slug / "_index.md").write_text(frontmatter(name, extra) + body)
    return slug


