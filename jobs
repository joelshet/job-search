POSTINGS = ROOT / "_postings"  # downloaded feeds, out of git; ./jobs postings rebuilds all of it
BOARDS = POSTINGS / "boards.tsv"  # the feed each company posts to, so later pulls skip the guessing
SEARCH_CLI = Path(os.environ.get("SEARCH_CLI", Path.home() / "repos/wasm-static-search/target/release/search-cli"))

FEEDS = {
    "greenhouse": "https://boards-api.greenhouse.io/v1/boards/{}/jobs?content=true&pay_transparency=true",
    "ashby": "https://api.ashbyhq.com/posting-api/job-board/{}?includeCompensation=true",
    "lever": "https://api.lever.co/v0/postings/{}?mode=json",
    "workable": "https://apply.workable.com/api/v1/widget/accounts/{}?details=true",
    "recruitee": "https://{}.recruitee.com/api/offers/",
}
# A feed's token as it appears in links to its postings.
FEED_LINKS = [
    ("greenhouse", re.compile(r"(?:boards|job-boards)(?:-api)?\.greenhouse\.io/(?:embed/job_board\?for=|v1/boards/)?([\w-]+)", re.I)),
    ("ashby", re.compile(r"jobs\.ashbyhq\.com/([\w.%-]+)", re.I)),
    ("lever", re.compile(r"jobs\.lever\.co/([\w.-]+)", re.I)),
    ("workable", re.compile(r"apply\.workable\.com/([\w-]+)", re.I)),
    ("recruitee", re.compile(r"(?<![\w-])([\w-]{1,64})\.recruitee\.com", re.I)),
]
FEED_HOST = {"greenhouse": "greenhouse.io", "ashby": "ashbyhq.com", "lever": "lever.co",
             "workable": "workable.com", "recruitee": "recruitee.com"}
NOT_TOKENS = {"embed", "api", "v1", "jobs", "j", "careers", "www"}
BLOCKS = {"p", "div", "li", "br", "h1", "h2", "h3", "h4", "h5", "h6", "tr", "ul", "ol", "section"}
_AMOUNT = r"(\d{2,3})(?:,(\d{3})(?:\.\d+)?|(?:\.\d+)?\s?[kK]\b)"
_TO = r"\s*(?:-|–|—|to|and)\s*"
# A range's second figure often drops the dollar sign ($150,000-200,000). A figure after A$ or C$ isn't in US dollars.
DOLLARS = re.compile(rf"(?<![A-Za-z])(?:\$|USD)\s?{_AMOUNT}(?:\s?USD)?(?:{_TO}(?:USD\s?)?\$?\s?{_AMOUNT})?")
# 185,000 - 200,000 per year, with no dollar sign at all. Another currency's sign or code in front rules it out.
BARE_RANGE = re.compile(r"(?<![\d,.$€£])(?<![A-Z]{3} )(?<![A-Z]{3})(\d{2,3}),(\d{3})(?:\s?USD)?" + _TO + r"(\d{2,3}),(\d{3})")
PAY_WORDS = re.compile(r"salar|compensat|\bpay\b|\bwages?\b|earnings|\bOTE\b|per year|annual|\bbase\b|hiring range|"
                       r"expect to make|ranges?\b", re.I)
NOT_PAY = re.compile(r"portfolio|\bdeals?\b|revenue|\bARR\b|\bACV\b|funding|\braised?\b|budget|\bspend|contract|"
                     r"book of|valuation|savings|pipeline|bookings|typical sales|\bin sales\b", re.I)
NOT_DOLLARS = re.compile(r"\b(CAD|AUD|NZD|SGD|HKD|MXN)\b")


class TextOf(HTMLParser):
    """A posting's HTML as plain paragraphs, list items marked with a bullet."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out = []

    def handle_starttag(self, tag, attrs):
        if tag in BLOCKS:
            self.out.append("\n• " if tag == "li" else "\n")

    def handle_endtag(self, tag):
        if tag in BLOCKS:
            self.out.append("\n")

    def handle_data(self, data):
        self.out.append(data)


def paragraphs(markup):
    for _ in range(3):  # Greenhouse escapes its HTML, sometimes twice
        if "&lt;" not in markup:
            break
        markup = html.unescape(markup)
    if "<" not in markup:
        text = markup
    else:
        parser = TextOf()
        parser.feed(markup)
        text = "".join(parser.out)
    lines = (re.sub(r"\s+", " ", line).strip() for line in text.split("\n"))
    return [line for line in lines if line.strip("• ")]


def fetch_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (job-search jobs postings)"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.load(r)
    except (urllib.error.URLError, TimeoutError, ValueError, OSError):
        return None


def money(n):
    return f"${round(n / 1000)}k"


def pay_from_text(paras):
    """The band a posting states. A figure counts near pay wording, or on a short line of its own ("Staff: $181,000-$272,000")."""
    found = []
    for para in paras:
        for pattern, bare in ((DOLLARS, False), (BARE_RANGE, True)):
            for m in pattern.finditer(para):
                before, after = para[max(0, m.start() - 150):m.start()], para[m.end():m.end() + 60]
                worded = PAY_WORDS.search(before) or PAY_WORDS.search(after)
                if not (worded or (not bare and len(para) < 80)):
                    continue
                if NOT_PAY.search(before[-60:]) or NOT_PAY.search(after[:40]) or NOT_DOLLARS.search(before[-5:] + " " + after[:12]):
                    continue
                g = m.groups()
                found += [int(g[i]) * 1000 + int(g[i + 1] or 0) for i in (0, 2) if g[i]]
    found = [n for n in found if 40_000 <= n <= 900_000]
    return (min(found), max(found), "USD") if found else (None, None, None)


def posting(company, ats, title, location, remote, url, posted, markup, pay=(None, None, None), team=""):
    lo, hi, currency = pay
    paras = paragraphs(markup or "")
    if hi is None:
        lo, hi, currency = pay_from_text(paras)
    return {"title": (title or "").strip(), "location": (location or "").strip(), "remote": remote,
            "url": url, "posted": (posted or "")[:10], "paras": paras, "lo": lo, "hi": hi,
            "currency": currency or "", "team": team or ""}


def read_feed(ats, data):
    """A feed's postings in one shape, or None when the feed isn't there."""
    if data is None:
        return None
    if ats == "greenhouse":
        if "jobs" not in data:
            return None
        out = []
        for j in data["jobs"]:
            ranges = j.get("pay_input_ranges") or []
            pay = (min(r["min_cents"] for r in ranges) / 100, max(r["max_cents"] for r in ranges) / 100,
                   ranges[0].get("currency_type")) if ranges else (None, None, None)
            where = (j.get("location") or {}).get("name", "")
            out.append(posting("", ats, j.get("title"), where, "remote" in where.lower() or None,
                               j.get("absolute_url"), j.get("first_published") or j.get("updated_at"),
                               j.get("content"), pay, ", ".join(d["name"] for d in j.get("departments", []))))
        return out
    if ats == "ashby":
        if "jobs" not in data:
            return None
        out = []
        for j in data["jobs"]:
            if j.get("isListed") is False:
                continue
            salary = [c for c in ((j.get("compensation") or {}).get("summaryComponents") or [])
                      if c.get("compensationType") == "Salary" and c.get("maxValue")]
            pay = (salary[0].get("minValue"), salary[0]["maxValue"], salary[0].get("currencyCode")) if salary else (None, None, None)
            where = j.get("location", "")
            remote = j.get("isRemote") or (j.get("workplaceType") or "").lower() == "remote" or None
            out.append(posting("", ats, j.get("title"), where, remote, j.get("jobUrl"), j.get("publishedAt"),
                               j.get("descriptionHtml") or j.get("descriptionPlain"), pay, j.get("department", "")))
        return out
    if ats == "lever":
        if not isinstance(data, list):
            return None
        out = []
        for j in data:
            cats = j.get("categories") or {}
            s = j.get("salaryRange") or {}
            pay = (s.get("min"), s["max"], s.get("currency")) if s.get("max") and s.get("interval", "per-year-salary") == "per-year-salary" else (None, None, None)
            body = j.get("description", "") + "".join(f"<h3>{x.get('text', '')}</h3><ul>{x.get('content', '')}</ul>"
                                                     for x in j.get("lists", [])) + j.get("additional", "")
            created = datetime.date.fromtimestamp(j["createdAt"] / 1000).isoformat() if j.get("createdAt") else ""
            where = cats.get("location", "")
            remote = (j.get("workplaceType") == "remote") or "remote" in where.lower() or None
            out.append(posting("", ats, j.get("text"), where, remote, j.get("hostedUrl"), created, body, pay,
                               cats.get("team", "")))
        return out
    if ats == "workable":
        if "jobs" not in data:
            return None
        return [posting("", ats, j.get("title"), ", ".join(filter(None, (j.get("city"), j.get("state"), j.get("country")))),
                        j.get("telecommuting") or None, j.get("url") or j.get("application_url"), j.get("published_on"),
                        j.get("description"), team=j.get("department", "")) for j in data["jobs"]]
    if ats == "recruitee":
        if "offers" not in data:
            return None
        out = []
        for j in data["offers"]:
            s = j.get("salary") or {}
            pay = (float(s["min"]) if s.get("min") else None, float(s["max"]), s.get("currency")) if s.get("max") and s.get("period", "year") == "year" else (None, None, None)
            out.append(posting("", ats, j.get("title"), j.get("location"), j.get("remote") or None, j.get("careers_url"),
                               j.get("published_at"), (j.get("description") or "") + (j.get("requirements") or ""),
                               pay, j.get("department", "")))
        return out


def feed_tokens(text):
    """Every (feed, token) a page's text links to."""
    found = []
    lower = text.lower()
    for ats, pattern in FEED_LINKS:
        if FEED_HOST[ats] not in lower:  # a page without the host skips the regex, which is slow on big pages
            continue
        for token in pattern.findall(text):
            token = urllib.parse.unquote(token).strip(".")
            if token.lower() not in NOT_TOKENS and (ats, token) not in found:
                found.append((ats, token))
    return found


def board_guesses(slug, fm, known):
    """Feeds and tokens to try: links on file first, then tokens made from the company's names."""
    extra = fm.get("extra", {})
    linked = list(known.get(slug, []))
    host_root = urllib.parse.urlsplit(extra.get("website", "")).netloc.lower().removeprefix("www.").split(".")[0]
    names = [slug, slug.replace("-", ""), host_root, compact(fm["title"]), *extra.get("aliases", [])]
    guessed = []
    for name in names:
        name = name.lower().strip()
        if name and name not in guessed:
            guessed.append(name)
    return linked, [(ats, name) for name in guessed for ats in FEEDS]


def names_company(fm, jobs, board_name=""):
    """Whether a guessed feed belongs to this company: its whole name or its domain shows up in the postings.
    A shorter test let a feed named "guild" or "make" pass for unrelated companies."""
    text = board_name + " " + " ".join(" ".join(j["paras"][:40]) for j in jobs[:6])
    host = urllib.parse.urlsplit(fm["extra"].get("website", "")).netloc.lower().removeprefix("www.")
    return compact(fm["title"]) in compact(text) or bool(host) and host in text.lower()


def find_board(slug, fm, known):
    linked, guessed = board_guesses(slug, fm, known)
    for ats, token in linked:
        jobs = read_feed(ats, fetch_json(FEEDS[ats].format(token)))
        if jobs is not None:
            return ats, token, "linked", jobs
    for ats, token in guessed:
        jobs = read_feed(ats, fetch_json(FEEDS[ats].format(token)))
        if not jobs:
            continue
        board = (fetch_json(f"https://boards-api.greenhouse.io/v1/boards/{token}") or {}).get("name", "") if ats == "greenhouse" else ""
        if names_company(fm, jobs, board):
            return ats, token, "guessed", jobs
    return "-", "-", "none", []


def linked_boards():
    """Feed tokens from links on file: role URLs, company websites, and captured homepages."""
    known = {}
    for slug, d in companies():
