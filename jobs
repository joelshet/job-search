def cmd_check(args):
    problems = []
    for ident, _, fm in dossiers():
        extra = fm.get("extra", {})
        # Only where it matters: triage's o key opens the website, and a company the user already
        # said no to never comes back up.
        if "/" not in ident and not extra.get("website") \
                and extra.get("triage") != "n" and extra.get("screen") != "FAIL":
            problems.append(f"{ident}: company has no extra.website (triage's o key needs it)")
        problems += [f"{ident}: {p}" for p in state_problems(extra)]
    urls = {}
    for role_id, path, fm in roles():
        url = normalize_url(fm.get("extra", {}).get("url", "")) if fm.get("extra", {}).get("url") else ""
        if not url:
            problems.append(f"{role_id}: role has no extra.url")
        elif url in urls:
            problems.append(f"{role_id}: same url as {urls[url]}")
        else:
            urls[url] = role_id
    seen = {}
    role_ids = {r[0] for r in roles()}
    for app_id, _, fm in applications():
        role = fm.get("extra", {}).get("role", "")
        if role not in role_ids:
            problems.append(f"{app_id}: role '{role}' has no dossier")
        if role in seen:
            problems.append(f"{app_id}: duplicate application for {role} (also {seen[role]})")
        seen[role] = app_id
    for p in problems:
        print(p, file=sys.stderr)
    if problems:
        sys.exit(1)


def shot_path(slug):
    return COMPANIES / slug / SHOT


def shoot_targets(args):
    """(slug, website) per company to capture, in dossier order."""
    if args.ids:
        out, done = [], 0
        for ident in [dossier_id(i) for i in args.ids]:
            if "/" in ident or not (COMPANIES / ident / "_index.md").exists():
                die(f"'{ident}' is not a company")
            extra = read_doc(COMPANIES / ident / "_index.md")[0].get("extra", {})
            if not extra.get("website"):
                print(f"{ident}: no extra.website to capture", file=sys.stderr)
                continue
            if extra.get("captured") and not args.again:
                done += 1
                continue
            out.append((ident, extra["website"]))
        if done:
            print(f"{done} already captured; --again retakes them", file=sys.stderr)
        return out
    out = []
    for slug, d in companies():
        extra = read_doc(d / "_index.md")[0].get("extra", {})
        if not extra.get("website"):
            continue
        if args.issues:
            if extra.get("issue"):
                out.append((slug, extra["website"]))
        elif args.errors:
            if extra.get("site_error"):
                out.append((slug, extra["website"]))
        elif args.again or not extra.get("captured"):
            out.append((slug, extra["website"]))
    return out


def shrink(png, jpg):
    """A phone screenshot is 1080px wide and 170KB; the card needs neither."""
    r = subprocess.run(["sips", "-Z", str(SHOT_WIDTH), "-s", "format", "jpeg",
                        "-s", "formatOptions", "70", str(png), "--out", str(jpg)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if r.returncode:
        die(f"sips failed on {png}: {r.stderr.strip()}")


def capture_dossier(slug, site, status, ms, rest):
    """File one crawled site: the screenshot, and what the site says about itself."""
    path = COMPANIES / slug / "_index.md"
    if status == "error":
        write_state(path, {"captured": today(), "site_error": rest})
        print("\t".join([slug, "error", "-", "-", "-", "-", rest]), flush=True)
        return False
    meta = json.loads((Path(rest) / "meta.json").read_text())
    png = Path(rest) / "shot.png"
    shot = SHOT if png.exists() else "-"
    if png.exists():
        shrink(png, shot_path(slug))
    title, desc, profiles = site_facts((Path(rest) / "page.html").read_text(errors="replace"))
    same = company_token(meta["url"]) == company_token(site)
    write_state(path, {
        "captured": today(), "site_title": title or None, "site_description": desc or None,
        "site_final": None if same else meta["url"], "profiles": profiles or None,
        "site_error": None, **({"issue": None} if shot == SHOT else {})})
    print("\t".join([slug, str(meta["status"]), ms, shot, str(len(profiles)),
                     "-" if same else meta["url"], meta["title"]]), flush=True)
    return png.exists()


def cmd_shoot(args):
    """Screenshot each company's website on the phone and file it beside the dossier."""
    if not os.access(ARB, os.X_OK):
        die(f"no arb at {ARB} (set $ARB to the android-remote-browser checkout)")
    targets = shoot_targets(args)
    if args.limit:
        targets = targets[:args.limit]
    if not targets:
        print("nothing to shoot", file=sys.stderr)
        return
    out = CAPTURES / datetime.datetime.now().strftime("%Y-%m-%dT%H%M%S")
    out.mkdir(parents=True)
    print(f"shooting {len(targets)} sites on the phone into {out.relative_to(ROOT)}", file=sys.stderr)
    print("\t".join(["id", "status", "ms", "shot", "profiles", "final_url", "title"]))
    failed, total = 0, len(targets)
    # arb has died mid-run on long crawls, so keep starting it again while it still makes
    # progress. Each pass reuses the same directory, where arb skips what it already captured.
    while targets:
        done, failed = crawl(targets, out, failed)
        targets = [(slug, site) for slug, site in targets
                   if not read_doc(COMPANIES / slug / "_index.md")[0].get("extra", {}).get("captured")]
        if not done or not targets:
            break
        print(f"arb stopped with {len(targets)} left; starting it again", file=sys.stderr)
    if failed:
        print(f"{failed} of {total} produced no screenshot", file=sys.stderr)
        sys.exit(1)


def crawl(targets, out, failed):
    """One arb crawl over these targets. Returns (how many it filed, the running failure count)."""
    done = 0
    slugs = {normalize_url(site): slug for slug, site in targets}
    p = subprocess.Popen([str(ARB), "crawl", "-o", str(out), "--shot"],
                         stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)

    def feed():
        """A thread, so a full stdout pipe can never stall the URLs going in."""
        with p.stdin:
            for _, site in targets:
                p.stdin.write(site + "\n")

    threading.Thread(target=feed, daemon=True).start()
    try:
        for line in p.stdout:
            if not line.endswith("\n"):
                break  # arb died mid-line; the outer loop starts it again
            fields = line.rstrip("\n").split("\t")
            if len(fields) != 4:
                continue
            status, ms, site, rest = fields
            slug = slugs.get(normalize_url(site)) if site else None
            if not slug:
                failed += 1
                print("\t".join(["?", "unmatched", "-", "-", "-", site, rest]), flush=True)
                continue
            try:
                done += 1
                if not capture_dossier(slug, site, status, ms, rest):
                    failed += 1
            except (OSError, ValueError, KeyError, SystemExit) as e:
                failed += 1
                print("\t".join([slug, "unsaved", "-", "-", "-", "-", str(e)]), flush=True)
    except KeyboardInterrupt:
        p.terminate()
        print("stopped; rerun to pick up where it left off", file=sys.stderr)
        p.wait()
        sys.exit(130)
    p.wait()
    return done, failed


def cmd_inbox(args):
    """List inbox files, then classify every URL found in their text."""
    files = sorted(p for p in INBOX.rglob("*") if p.is_file() and not p.name.startswith("."))
    if not files:
        print("inbox is empty", file=sys.stderr)
        return
    print("# files")
    for f in files:
        print(f"{f.stat().st_size}\t{f.relative_to(ROOT)}")
    urls = []
    for f in files:
        try:
            text = f.read_text()
        except UnicodeDecodeError:
            continue
        found = re.findall(r"https?://[^\s<>\"')\]]+", text)
        # A saved page's own URL is its first line; links inside the page text are noise.
        urls += [(u, f) for u in (found[:1] if f.name.endswith(".page.txt") else found)]
    if urls:
        print("# urls")
        match_urls(urls)


def osascript(script):
    r = subprocess.run(["osascript", "-"], input=script, capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError(r.stderr.strip())
    return r.stdout


def as_quote(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def pick_browser(name):
    if name:
        if name not in BROWSERS:
            die(f"--browser must be one of: {', '.join(BROWSERS)}")
        return name
    front = osascript('tell application "System Events" to get name of first process whose frontmost is true').strip()
    if front in BROWSERS:
        return front
    running = osascript('tell application "System Events" to get name of every process').strip().split(", ")
    for b in BROWSERS:
        if b in running:
            return b
    die("no supported browser is running")


def browser_tabs(browser, with_text):
    """Return [(url, title, text)] for the front window's tabs."""
    title_prop = "name" if browser == "Safari" else "title"
    out = osascript(f'''
set sep to (ASCII character 31)
set out to ""
tell application {as_quote(browser)}
  repeat with t in tabs of front window
    set out to out & (URL of t) & sep & ({title_prop} of t) & linefeed
  end repeat
end tell
return out''')
    tabs = [line.split("\x1f", 1) + [""] for line in out.splitlines() if "\x1f" in line]
    tabs = [(u, title, "") for u, title, _ in tabs if u.startswith("http")]
    if not with_text:
        return tabs
    result, warned = [], False
    for i, (url, title, _) in enumerate(tabs):
        text = ""
        try:
            if browser == "Safari":
                js = f'tell application "Safari" to do JavaScript "document.body.innerText" in (first tab of front window whose URL is {as_quote(url)})'
            else:
                js = f'tell application {as_quote(browser)} to execute (first tab of front window whose URL is {as_quote(url)}) javascript "document.body.innerText"'
            text = osascript(js)
        except RuntimeError as e:
            if not warned:
                where = "Safari: Develop menu" if browser == "Safari" else f"{browser}: View > Developer menu"
                print(f"jobs: page text not captured ({e}). Turn on 'Allow JavaScript from Apple Events' in {where}, or pass --no-text.",
                      file=sys.stderr)
                warned = True
        result.append((url, title, text))
    return result


def write_grab(tabs, intent, browser):
    stamp = datetime.datetime.now().strftime("%Y-%m-%d-%H%M%S")
    d = INBOX / f"{stamp}-{intent}"
    d.mkdir(parents=True)
    lines = [f"# intent: {intent}", f"# browser: {browser}"]
    lines += [f"{url}\t{title}" for url, title, _ in tabs]
    (d / "tabs.txt").write_text("\n".join(lines) + "\n")
    for i, (url, title, text) in enumerate(tabs, 1):
        if text.strip():
            (d / f"{i:02d}.page.txt").write_text(f"{url}\n{title}\n\n{text.strip()}\n")
    return d


def cmd_grab(args):
    browser = pick_browser(args.browser)
    try:
        tabs = browser_tabs(browser, not args.no_text)
    except RuntimeError as e:
        die(f"could not read {browser} tabs: {e}. The first run needs macOS to allow automation of {browser}.")
    if not tabs:
        die(f"no web tabs in the front {browser} window")
    d = write_grab(tabs, args.intent, browser)
    print(d.relative_to(ROOT))
    if args.go:
        prompt = "Process the inbox" if args.intent == "research" else "Process the inbox and start applications for the grabbed roles"
