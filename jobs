def read_boards():
    if not BOARDS.exists():
        return {}
    rows = [line.split("\t") for line in BOARDS.read_text().splitlines()[1:] if line]
    return {r[0]: r[1:] for r in rows}


def tsv_cell(text):
    return str(text).replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n")


def tags(job, label):
    words = []
    if job["remote"]:
        words.append("remote")
    if job["hi"] and job["currency"] in ("USD", ""):
        words += [f"{k}k" for k in range(100, 301, 10) if job["hi"] >= k * 1000]
    if not job["hi"]:
        words.append("nopay")
    if label in ("Y", "y"):
        words.append("yes")
    return " ".join(words)


def chunks(paras, words=100):
    """Paragraphs joined into runs of about this many words; a record per paragraph made a 200 MB index."""
    out, run = [], []
    for para in paras:
        run.append(para)
        if sum(len(p.split()) for p in run) >= words:
            out.append(" ¶ ".join(run))
            run = []
    if run:
        out.append(" ¶ ".join(run))
    return out


def write_postings(found):
    """postings.tsv, one line per posting, and records.tsv for the search engine, one line per paragraph."""
    refs = set()
    rows, records = [], []
    everywhere = Counter(para for *_, jobs in found for job in jobs for para in set(job["paras"]))
    for slug, company, label, ats, jobs in found:
        # A paragraph in three of a company's postings, or in 20 anywhere, is its about-us, benefits, or legal text.
        theirs = Counter(para for job in jobs for para in set(job["paras"]))
        for job in jobs:
            job["paras"] = [para for para in job["paras"]
                            if (theirs[para] < 3 or len(jobs) < 3) and everywhere[para] < 20]
        for job in jobs:
            name = f"{company} · {job['title']}"
            for extra in (job["location"], job["url"]):
                if name not in refs:
                    break
                name = f"{name} ({extra})"
            refs.add(name)
            pay = ""
            if job["hi"]:
                pay = f"{money(job['lo'])}-{money(job['hi'])}" if job["lo"] and job["lo"] != job["hi"] else money(job["hi"])
                pay += "" if job["currency"] in ("USD", "") else f" {job['currency']}"
            is_ = tags(job, label)
            rows.append([slug, label, ats, job["title"], job["location"], "remote" if job["remote"] else "", pay,
                         job["posted"], job["url"], " \\n ".join(job["paras"])])
            head = ". ".join(filter(None, (job["title"], company, job["team"], job["location"], pay)))
            fields = [company, job["location"], pay, label if label != "-" else "", job["posted"], is_, job["url"]]
            for i, text in enumerate([head, *chunks(job["paras"])], 1):
                records.append([f"{name} {i}", text, *fields])
    POSTINGS.mkdir(exist_ok=True)
    with (POSTINGS / "postings.tsv").open("w") as f:
        f.write("company\tlabel\tfeed\ttitle\tlocation\tremote\tpay\tposted\turl\ttext\n")
        for row in rows:
            f.write("\t".join(tsv_cell(c) if i < 9 else c.replace("\t", " ") for i, c in enumerate(row)) + "\n")
    with (POSTINGS / "records.tsv").open("w") as f:
        f.write("#ref\ttext\tcompany\tlocation\tpay\tlabel\tposted\tis\tlink\n")
        for row in records:
            f.write("\t".join(tsv_cell(c) for c in row) + "\n")
    return len(rows), len(records)


def build_site():
    if not SEARCH_CLI.exists():
        print(f"jobs: no search page built; {SEARCH_CLI} isn't there (SEARCH_CLI names another)", file=sys.stderr)
        return
    index = POSTINGS / "index.bin"
    with index.open("wb") as out:
        subprocess.run([str(SEARCH_CLI), "index", str(POSTINGS / "records.tsv")], stdout=out, check=True)
    site = POSTINGS / "site"
    shutil.rmtree(site, ignore_errors=True)
    subprocess.run([str(SEARCH_CLI), "bundle", str(index), "-o", str(site), "--name", "Jobs",
                    "--about", "Every open posting at the companies on file. is:remote, is:150k, label:y and in:company narrow it."],
                   check=True, stdout=subprocess.DEVNULL)
    print(f"jobs: search page in {site.relative_to(ROOT)}; serve it with: ./jobs postings --serve", file=sys.stderr)


def cmd_postings(args):
    if args.serve:
        site = POSTINGS / "site"
        if not site.exists():
            die("no search page yet; run ./jobs postings first")
        handler = lambda *a, **k: http.server.SimpleHTTPRequestHandler(*a, directory=str(site), **k)
        server = http.server.ThreadingHTTPServer(("127.0.0.1", args.port), handler)
        url = f"http://127.0.0.1:{args.port}/"
        print(f"jobs: serving {url}", file=sys.stderr)
        webbrowser.open(url)
        server.serve_forever()
    boards = {} if args.reprobe else read_boards()
    known = linked_boards()
    targets = []
    for slug, d in companies():
        fm = read_doc(d / "_index.md")[0]
        label = fm.get("extra", {}).get("triage", "-")
        if label != "n":
            targets.append((slug, fm, label))

    def pull(target):
        slug, fm, label = target
        if slug in boards and boards[slug][0] != "-":
            ats, token, how = boards[slug][:3]
            jobs = read_feed(ats, fetch_json(FEEDS[ats].format(token)))
            if jobs is not None:
                return slug, fm["title"], label, ats, token, how, jobs
        if slug in boards and boards[slug][0] == "-" and not args.probe:
            return slug, fm["title"], label, "-", "-", "none", []
        return slug, fm["title"], label, *find_board(slug, fm, known)

    with ThreadPoolExecutor(args.threads) as pool:
        results = list(pool.map(pull, targets))
    POSTINGS.mkdir(exist_ok=True)
    with BOARDS.open("w") as f:
        f.write("company\tfeed\ttoken\thow\tchecked\n")
        for slug, _, _, ats, token, how, _ in results:
            f.write(f"{slug}\t{ats}\t{token}\t{how}\t{today()}\n")
    found = [(slug, company, label, ats, jobs) for slug, company, label, ats, _, _, jobs in results if jobs]
    count, records = write_postings(found)
    feeds = {}
    for _, _, _, ats, *_ in results:
        feeds[ats] = feeds.get(ats, 0) + 1
    print(f"jobs: {len(targets)} companies, {sum(v for k, v in feeds.items() if k != '-')} with a feed "
          f"({', '.join(f'{k} {v}' for k, v in sorted(feeds.items()) if k != '-')}), "
          f"{count} postings, {records} records", file=sys.stderr)
    if not args.no_site:
        build_site()


