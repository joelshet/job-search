def print_pdf(page, out, spaced=False):
    """Print a built page to PDF. The spaced copy is written beside the original
    so any relative URL in it still resolves."""
    if not page.exists():
        die(f"{page.relative_to(BUILD)} is not in the build; run zola build")
    src = page
    if spaced:
        src = page.with_name("_spaced.html")
        src.write_text(page.read_text().replace("</head>", SPACED_STYLE + "\n</head>"))
    try:
        subprocess.run([CHROME, "--headless", "--disable-gpu", "--no-pdf-header-footer",
                        f"--print-to-pdf={out}", src.as_uri()],
                       check=True, capture_output=True)
