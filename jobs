def cmd_serve(args):
    os.chdir(ROOT)
    os.execvp("zola", ["zola", "serve", "--port", str(args.port), "--open"])


def zola_build():
    r = subprocess.run(["zola", "build", "--output-dir", str(BUILD), "--force"],
                       cwd=ROOT, capture_output=True, text=True)
    if r.returncode:
        sys.stderr.write(r.stdout + r.stderr)
        return False
    return True


def commit_state():
    """Commit dossiers whose only uncommitted change is pipeline fields or notes.

    A dossier that also has research edits is left for the commit that goes with those edits."""
    r = subprocess.run(["git", "diff", "--name-only", "HEAD", "--", str(COMPANIES), str(PEOPLE)],
                       cwd=ROOT, capture_output=True, text=True)
    if r.returncode:
        return
    paths = []
    for name in r.stdout.splitlines():
        head = subprocess.run(["git", "show", f"HEAD:{name}"], cwd=ROOT, capture_output=True, text=True)
        work = ROOT / name
        if name.endswith(".md") and not head.returncode and work.exists() \
                and without_state(head.stdout) == without_state(work.read_text()):
            paths.append(name)
    if not paths:
        return
    subprocess.run(["git", "add", "--", *paths], cwd=ROOT, check=True)
    r = subprocess.run(["git", "commit", "-q", "-m", "Record triage labels, notes, and content flags", "--", *paths],
                       cwd=ROOT, capture_output=True, text=True)
    if r.returncode:
        sys.stderr.write(r.stdout + r.stderr)
    else:
        print(f"triage: committed labels, notes, and flags in {len(paths)} dossiers")


def cmd_triage(args):
    # Commit on the way in too, so a session that ended without ctrl-c still lands in git.
    commit_state()
    if not zola_build():
        die("zola build failed")

    class Handler(http.server.SimpleHTTPRequestHandler):
        def __init__(self, *a, **kw):
            super().__init__(*a, directory=str(BUILD), **kw)

        def log_message(self, *a):
            pass

        def send_json(self, obj, code=200):
            body = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.path == "/api/labels":
                return self.send_json(triage_labels())
            if self.path == "/api/flags":
                return self.send_json({k: sorted(v) for k, v in current_flags().items()})
            if self.path == "/api/notes":
                return self.send_json({ident: [[n["time"][:10], n["text"]] for n in fm["extra"]["notes"]]
                                       for ident, _, fm in triage_items() if fm.get("extra", {}).get("notes")})
            if self.path == "/":
                # The home page counts labels at build time, so rebuild to show the ones just made.
                zola_build()
            super().do_GET()

        def do_POST(self):
            n = int(self.headers.get("Content-Length", 0))
            data = json.loads(self.rfile.read(n) or b"{}")
            path = dossier_path(str(data.get("id", "")))
            try:
                if self.path == "/api/label":
                    label = data.get("label")
                    if label not in LABELS + [""] or not path:
                        return self.send_json({"error": "bad label"}, 400)
                    write_state(path, {"triage": label, "triaged": now()} if label else {"triage": None, "triaged": None})
                    return self.send_json({"ok": True})
                if self.path == "/api/flag":
                    if data.get("flag") not in FLAGS or not path:
                        return self.send_json({"error": "bad flag"}, 400)
                    write_state(path, {data["flag"]: True if data.get("on") else None})
                    return self.send_json({"ok": True})
                if self.path == "/api/note":
                    if not str(data.get("note", "")).strip() or not path:
                        return self.send_json({"error": "bad note"}, 400)
                    write_state(path, {}, [(now(), data["note"])])
                    return self.send_json({"ok": True})
            except SystemExit:
                return self.send_json({"error": "not saved; see the terminal"}, 400)
            if self.path == "/api/rebuild":
                return self.send_json({"ok": zola_build()})
            if self.path == "/api/edit":
                if not path:
                    return self.send_json({"error": "not found"}, 404)
                if shutil.which("zed"):
                    cmd = ["zed", str(path)]
                elif Path(ZED).exists():
                    cmd = ["open", "-a", ZED, str(path)]
                else:
                    cmd = ["open", "-t", str(path)]
                subprocess.Popen(cmd)
                return self.send_json({"ok": True})
            self.send_json({"error": "not found"}, 404)

    server = http.server.ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    url = f"http://127.0.0.1:{args.port}/triage/"
    print(f"triage: {url}  (ctrl-c to stop)")
    if not args.no_open:
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
        commit_state()


